# Secrets. The Spotify client secret lives here and must never be committed.
.env
.env.local
.env.*.local

# Data. The SQLite database is per-instance state, not source.
/data/
*.db
*.db-wal
*.db-shm

node_modules/
.next/
out/
dist/

# Screenshots are build output, regenerated by `npm run shots`.
/tests/shots/*.png

# Recorded fixtures ARE committed: they are the record of what upstream looked
# like when it worked, and their diff is how we find out a source changed.
# (No ignore rule for tests/fixtures/ — this comment exists so nobody adds one.)

*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

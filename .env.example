# Copy to .env and fill in. `.env` is gitignored and must never be committed.
#
# Every value here is per-instance. Nothing about Berlin or any particular
# person belongs in source: the city is config, and so is everything else.

# --- Spotify (required) -----------------------------------------------------
# Create an app at https://developer.spotify.com/dashboard
# Redirect URI: http://localhost:3000/api/auth/callback/spotify
# The app owner needs Spotify Premium or the API stops responding.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Your instance ----------------------------------------------------------
# The city gigs are fetched for. Adapters must read this, never hardcode it.
BANDELION_CITY=Berlin
# IANA timezone, used for "this week" grouping in the feed.
BANDELION_TIMEZONE=Europe/Berlin

# Trailing window for releases, and how far ahead to look for announced ones.
RELEASE_WINDOW_MONTHS_BACK=4
RELEASE_WINDOW_MONTHS_FORWARD=2

# --- Ticketmaster (optional, P1) --------------------------------------------
# Free key from https://developer.ticketmaster.com — 5000 calls/day.
# Official and stable, but covers mostly large venues.
TICKETMASTER_API_KEY=

# --- Unofficial sources (optional, P1/P2) -----------------------------------
# These have no keys. They are public endpoints and scraped pages, and they are
# what makes local coverage good. They can change without notice; when one
# breaks it is marked degraded and the rest of the feed carries on.
# Set to 0 to disable any of them.
ENABLE_EVENTIM=1
ENABLE_RESIDENTADVISOR=1
ENABLE_PROMOTER_CRAWLERS=1

# --- Runtime ----------------------------------------------------------------
DATABASE_PATH=./data/bandelion.db
# Secret used to encrypt stored OAuth tokens at rest.
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
